{
  "redirects": [
    {
      "source": "/intel",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intel/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intel/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intel/family-office",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intel/family-office/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/intel/family-office/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/systems/fuel-retail",
      "destination": "/systems/",
      "permanent": true
    },
    {
      "source": "/systems/fuel-retail/",
      "destination": "/systems/",
      "permanent": true
    },
    {
      "source": "/systems/fuel-retail/index.html",
      "destination": "/systems/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
